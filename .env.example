# Environment template — copy to `.env` at the repo root.
# Never commit real secrets.

NODE_ENV=development

# Database driver: sqlite for local development, postgresql for production.
# Docker Compose and production deployments use PostgreSQL.
DATABASE_PROVIDER=sqlite

# Shared JWT secret used by identity (sign) and gateway (verify)
JWT_SECRET=replace-with-long-random-string
JWT_ACCESS_EXPIRES=8h
JWT_REFRESH_EXPIRES_DAYS=7

# PostgreSQL connection (one cluster, schema-per-service; ignored in SQLite mode)
# DATABASE_URL and the per-service URLs below are used when DATABASE_PROVIDER=postgresql.
# In SQLite mode, the app stores local databases in .local-data/ automatically.
DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=identity
# Local staff seed (npm run prisma:identity:seed) — never use in production:
#   admin@vipcar.local / VipcarAdmin1!  (role admin)
#   ops@vipcar.local   / VipcarOps1!    (role ops_agent)
# Catalog / CMS / booking / notify / fleet use the same cluster with schema=* (also set via prisma:* scripts)
CATALOG_DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=catalog
CMS_DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=cms
BOOKING_DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=booking
NOTIFY_DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=notify
FLEET_DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=fleet
BILLING_DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=billing
DISPATCH_DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=dispatch
ANALYTICS_DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=analytics

NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379
# Fleet checkout hold TTL in seconds (clamped 300–900; default 600)
FLEET_HOLD_TTL_SECONDS=600

# Billing: active PaymentProvider (manual | konnect | flouci | stripe). Secrets never in git.
BILLING_DEFAULT_PROVIDER=manual
# Shared webhook gate (optional). Put ?token=... on KONNECT_WEBHOOK_URL / FLOUCI_WEBHOOK_URL
# or send header X-Vipcar-Webhook-Secret. Required for manual webhook path when set.
# BILLING_WEBHOOK_SECRET=
# Konnect (Tunisia PSP) — https://docs.konnect.network
# KONNECT_API_KEY=
# KONNECT_WALLET_ID=
# KONNECT_API_BASE_URL=https://api.preprod.konnect.network/api/v2
# KONNECT_WEBHOOK_URL=https://api.example.com/v1/billing/webhooks/konnect?token=replace-me
# Flouci (Tunisia PSP) — https://docs.flouci.com
# FLOUCI_PUBLIC_KEY=
# FLOUCI_PRIVATE_KEY=
# FLOUCI_API_BASE_URL=https://developers.flouci.com
# FLOUCI_WEBHOOK_URL=https://api.example.com/v1/billing/webhooks/flouci?token=replace-me
# FLOUCI_SUCCESS_URL=https://www.example.com/en/booking/payment-success
# FLOUCI_FAIL_URL=https://www.example.com/en/booking/payment-failed
# Stripe stub only (no live charges; optional local shape)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

GATEWAY_PORT=3000
IDENTITY_HTTP_PORT=3001
CATALOG_HTTP_PORT=3002
CMS_HTTP_PORT=3003
BOOKING_HTTP_PORT=3004
NOTIFY_HTTP_PORT=3005
FLEET_HTTP_PORT=3006
BILLING_HTTP_PORT=3007
DISPATCH_HTTP_PORT=3008
ANALYTICS_HTTP_PORT=3009
# Browser origins allowed by gateway CORS (comma-separated).
# Admin backoffice is path routing on the same web origin (/admin) — no second port.
WEB_ORIGIN=http://localhost:5173

# Ops notification targets (notify service; mock adapters log only until real providers)
OPS_WHATSAPP_TO=21655771077
OPS_EMAIL_TO=info@vipcar.com.tn
NOTIFY_CHANNELS=whatsapp,email
# Comma list to force mock adapter failures for retry testing: whatsapp,email
NOTIFY_MOCK_FAIL=

# Public site + /admin backoffice (apps/web) — gateway only, never microservice ports
VITE_API_URL=http://localhost:3000
VITE_GA_MEASUREMENT_ID=
