# Environment template — copy to `.env` at the repo root.
# Never commit real secrets.

NODE_ENV=development

# Shared JWT secret used by identity (sign) and gateway (verify)
JWT_SECRET=replace-with-long-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Identity PostgreSQL schema (one cluster, schema-per-service)
DATABASE_URL=postgresql://vipcar:vipcar@localhost:5432/vipcar?schema=identity

NATS_URL=nats://localhost:4222
REDIS_URL=redis://localhost:6379

GATEWAY_PORT=3000
IDENTITY_HTTP_PORT=3001
WEB_ORIGIN=http://localhost:5173

# Public site (apps/web)
VITE_API_URL=http://localhost:3000
VITE_GA_MEASUREMENT_ID=
