generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Article {
  id          String    @id @default(uuid())
  slug        String    @unique
  titleEn     String
  titleFr     String
  summaryEn   String
  summaryFr   String
  /// JSON array of { heading, text }
  sectionsEn  Json
  sectionsFr  Json
  imageKey    String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished])
  @@map("articles")
}

model FaqItem {
  id          String   @id @default(uuid())
  slug        String   @unique
  questionEn  String
  questionFr  String
  answerEn    String
  answerFr    String
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, sortOrder])
  @@map("faq_items")
}

model LegalPage {
  id          String    @id @default(uuid())
  slug        String    @unique
  titleEn     String
  titleFr     String
  bodyEn      String
  bodyFr      String
  isPublished Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isPublished])
  @@map("legal_pages")
}
