{
  "name": "@vipcar/notify",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "prisma generate && nest build",
    "start": "node dist/main.js",
    "start:dev": "node ../../scripts/prisma.cjs --app notify generate && nest start --watch",
    "prisma:generate": "node ../../scripts/prisma.cjs --app notify generate",
    "prisma:migrate": "node ../../scripts/prisma.cjs --app notify migrate",
    "prisma:deploy": "node ../../scripts/prisma.cjs --app notify deploy"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/microservices": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/schedule": "^5.0.1",
    "@prisma/client": "^6.14.0",
    "@vipcar/contracts": "1.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "nats": "^2.29.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/schematics": "^11.0.5",
    "@types/node": "^22.17.0",
    "prisma": "^6.14.0",
    "typescript": "^5.8.2"
  }
}
